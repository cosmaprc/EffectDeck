# jsfx_exec.ubsan.supp（Tests/Fuzz/Native）
# 的 jsfxexec が見つけて、まだ直していない UB。**直したら行を消す。**
# run.sh がこの的のときだけ UBSAN_OPTIONS の suppressions に渡す（FUZZ_UBSAN_SUPPRESSIONS= で外せる）。
# 効くのは写しの側で recover にしてある検査だけ（run.sh の compile_one: signed-integer-overflow と shift）。
# ここに無いものは今までどおり 1 回目で止まる。
#
# EEL2 の memset(dest, v, len)（nseel-ram.c __NSEEL_RAM_MemSet）。dest が負のとき len += dest を
# int のまま足すので、どちらも INT_MIN 近くで溢れる。arm64 も負の double は INT_MIN に飽和するので
# 同じ形で踏む。その先は __NSEEL_RAMAlloc の範囲の検査で止まり、VM の RAM の外は書かない。
# 再現: @init の 1 行 memset(-2147483648, 0, -2147483648);
signed-integer-overflow:__NSEEL_RAM_MemSet

# EEL2 の文字列の番号（eel_strings.h eel_string_context_state::GetStringForIndex）。値を
# (int)(val + 0.5) にしてから idx - EEL_STRING_UNNAMED_BASE（190000）などを int のまま引くので、
# 大きな負の数や -Inf（x86_64 でも arm64 でも INT_MIN に飽和）で溢れる。溢れた番号は
# WDL_PtrList::Get の範囲の検査で NULL になり、文字列の外は読まない。どのスクリプトでも書ける形で、
# 種（nonfinite.jsfx）からでも数秒で出た（音の -Inf を strncmp の番号に渡す形）。
# 再現: @init の 2 行 x = -2147483647 * 4; strlen(x);
signed-integer-overflow:GetStringForIndex

# gfx_lineto（ysfx_api_gfx_lice.hpp eel_lice_state::gfx_lineto）は座標を (int)floor(x) のまま
# LICE_ClipLine へ渡す。Patches/ysfx-effectdeck-ios.diff の effectdeck_gfx_coord（±2^28）は
# gfx_triangle・多角形・gfx_blurto にしか掛かっていない。ClipLine（lice_line.cpp）は
# y2 - y1・-y1 を int のまま取るので、int に収まる値（±2e9）でも溢れる（飽和の違いに依らない）。
# 再現: @gfx 100 100 の中で gfx_x = 0; gfx_y = 2000000000; gfx_lineto(0, -2000000000, 0);
signed-integer-overflow:ClipLine

# gfx_arc・gfx_circle も同じ（eel_lice_state::gfx_arc / gfx_circle は float のまま LICE_Arc /
# LICE_Circle へ渡し、effectdeck_gfx_coord が掛かっていない）。lice_arc.cpp の中は
# __DrawArc の xhi++ / yhi++、DrawClippedCircleAA の cy0 + y + 1 と、どこも中心と半径を int に
# してから足すので、INT_MAX の近くで溢れる。float に収まる値で起きる（飽和に依らない）。
# 根は 1 つ（ysfx の口で座標を切っていない）なので、このファイルはまとめて黙らせる。
# 再現: @gfx 100 100 の中で gfx_set(1, 1, 1, 1); gfx_arc(127, 50, 2147483520, 0, $pi, 1);
signed-integer-overflow:*/WDL/lice/lice_arc.cpp
