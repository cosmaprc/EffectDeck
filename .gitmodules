# 取得元は自分のアカウントの fork（中身は上流と同じ）。Xcode Cloud は submodule の
# リポジトリにも GitHub App の許可を求め、他人の Organization には入れられないため。
# 上流: https://github.com/Frieve-A/effetune / https://github.com/JoepVanlier/ysfx
# effetune を上げるときは fork に上流のタグ（dsp-v* と v*）を載せてから固定する。
[submodule "Vendor/effetune"]
	path = Vendor/effetune
	url = https://github.com/satomasahiro2005/effetune
	ignore = dirty
[submodule "Vendor/ysfx"]
	path = Vendor/ysfx
	url = https://github.com/satomasahiro2005/ysfx.git
	ignore = dirty
